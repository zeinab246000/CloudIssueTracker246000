# Copy this file to .env and adjust the values for your machine
PORT=3000
NODE_ENV=development

# Neon connection string (Neon Console → Connect). Never commit the real value.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Frontend origins allowed by CORS, comma-separated, no trailing slash
CORS_ORIGINS=http://localhost:8080

# Cloudflare Turnstile secret key. The value below is Cloudflare's TEST key
# (always passes, accepts only the dummy token XXXX.DUMMY.TOKEN.XXXX).
# On Vercel, set the real secret key from the Turnstile dashboard instead.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
